	measure 'Avg precision' = MAXX(TOPN(1, 'Models', 'Models'[Rank], ASC), 'Models'[AP value])
		formatString: 0.00%
		lineageTag: 37bc916c-8a82-5e42-ba9c-230795aa7c01

	measure 'ROC AUC' = MAXX(TOPN(1, 'Models', 'Models'[Rank], ASC), 'Models'[AUC value])
		formatString: 0.0000
		lineageTag: ca2d9bcd-997a-582f-bcac-0903fd1440d0

	measure 'Validation F1' = MAXX(TOPN(1, 'Models', 'Models'[Rank], ASC), 'Models'[Validation F1 value])
		formatString: 0.00%
		lineageTag: 4197503e-d5dc-5d31-9bf3-0ed5169aa013

	measure 'Cutoff score' = MAXX(TOPN(1, 'Models', 'Models'[Rank], ASC), 'Models'[Threshold value])
		formatString: 0.0000
		lineageTag: 481cad2a-2ab8-5c6d-ac77-31caf7aadf2d

	measure Precision = DIVIDE([True alerts],[True alerts]+[False alerts],0)
		formatString: 0.00%
		lineageTag: abb245a2-2d6a-59f4-8d8d-de64c433ca90

	measure Recall = DIVIDE([True alerts],[True alerts]+[Missed cases])
		formatString: 0.00%
		lineageTag: bc1501a3-8388-54a4-bddf-7e961a172f24

	measure 'F1 score' = DIVIDE(2*[True alerts],2*[True alerts]+[False alerts]+[Missed cases])
		formatString: 0.00%
		lineageTag: ea462488-205e-5dcd-b189-cacc3f80673b

	measure 'Test transactions' = [True alerts]+[False alerts]+[Missed cases]+[Correct clears]
		formatString: #,0
		lineageTag: b5400998-c450-56b4-a5af-8389bbb163da

	measure 'Test fraud rate' = DIVIDE([True alerts]+[Missed cases],[Test transactions])
		formatString: 0.000%
		lineageTag: 3f51b717-1977-5778-a7c6-abe6c39a3041

