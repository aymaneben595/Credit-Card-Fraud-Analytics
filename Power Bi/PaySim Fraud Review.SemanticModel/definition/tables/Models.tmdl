	partition Models = m
		mode: import
		source =
				let
				    Source = if ExportsFolder = null or Text.Trim(ExportsFolder) = "" then Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip) else File.Contents(ExportsFolder & "/model_metrics.csv"),
				    Headers = Table.PromoteHeaders(Csv.Document(Source, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Headers, {"model_name", "validation_rank", "tp", "fp", "fn", "tn", "average_precision", "auc", "validation_f1", "threshold", "test_start", "test_end"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"model_name", type text}, {"validation_rank", Int64.Type}, {"tp", Int64.Type}, {"fp", Int64.Type}, {"fn", Int64.Type}, {"tn", Int64.Type}, {"average_precision", type number}, {"auc", type number}, {"validation_f1", type number}, {"threshold", type number}, {"test_start", Int64.Type}, {"test_end", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
