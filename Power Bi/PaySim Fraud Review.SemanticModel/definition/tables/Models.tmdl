table Models
	lineageTag: f87ab2f8-0f8f-567c-9084-3ba971055239

	measure 'Model in focus' = MAXX(TOPN(1, 'Models', 'Models'[Rank], ASC), 'Models'[Model])
		lineageTag: f5f58ac1-362d-58e7-8d4a-b5b6bb02d214

	measure 'True alerts' = MAXX(TOPN(1, 'Models', 'Models'[Rank], ASC), 'Models'[TP count])
		formatString: #,0
