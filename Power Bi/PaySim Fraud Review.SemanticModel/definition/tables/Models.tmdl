	measure 'False alerts' = MAXX(TOPN(1, 'Models', 'Models'[Rank], ASC), 'Models'[FP count])
		formatString: #,0
		lineageTag: 76edce6e-6eef-5c08-81ac-0336a3971eca

	measure 'Missed cases' = MAXX(TOPN(1, 'Models', 'Models'[Rank], ASC), 'Models'[FN count])
		formatString: #,0
		lineageTag: 4e34771a-0fc4-5d85-8ada-3336164e51fc

	measure 'Correct clears' = MAXX(TOPN(1, 'Models', 'Models'[Rank], ASC), 'Models'[TN count])
		formatString: #,0
