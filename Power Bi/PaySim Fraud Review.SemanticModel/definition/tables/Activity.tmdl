table Activity
	lineageTag: d072a0e9-f6e5-5d34-a9e4-5746eacc9213

	measure Transactions = SUM(Activity[Volume])
		formatString: #,0
		lineageTag: 6d5372c0-1dd1-5d52-a899-067f08a6f1ce

	measure 'Fraud cases' = SUM(Activity[Label count])
		formatString: #,0
		lineageTag: 61f1f0ce-ecf9-5f82-ab2f-d052a324d019

	measure 'Fraud rate' = DIVIDE([Fraud cases], [Transactions])
		formatString: 0.000%
		lineageTag: 19a12526-afad-5112-98f5-4f777a84fdb3

	measure 'Fraud amount (bn)' = DIVIDE(SUM(Activity[Labelled amount]), 1000000000)
		formatString: 0.00
		lineageTag: 813eb546-f237-510c-8db1-1b01d9d5615e

	measure 'Volume share' = DIVIDE([Transactions], CALCULATE([Transactions], ALLSELECTED(Activity[Payment type])))
		formatString: 0.0%
		lineageTag: 9277d13e-a15b-57c1-8ac5-f640ec852a85

	column 'Simulation day'
		dataType: int64
		lineageTag: 8d8873a9-12f0-59d6-8d47-e72624ec7203
		summarizeBy: none
		sourceColumn: simulation_day

	column 'Payment type'
		dataType: string
		lineageTag: c8f53f9a-6bd9-5aa1-9e24-b0b9ffabbef3
		summarizeBy: none
		sourceColumn: type

	column Volume
		dataType: int64
		isHidden
		lineageTag: 7b331b88-ee7b-5d95-badf-96573dd2219b
		summarizeBy: none
		sourceColumn: transactions

	column 'Label count'
		dataType: int64
		isHidden
		lineageTag: 618c1dfa-b0c4-5281-a3d8-24fe3cce75a5
		summarizeBy: none
		sourceColumn: fraud_cases

	column 'Labelled amount'
		dataType: decimal
		isHidden
		lineageTag: aeb48f1b-7694-5d8c-8775-e0dce69b3080
		summarizeBy: none
		sourceColumn: fraud_amount

	partition Activity = m
		mode: import
		source =
				let
				    Source = if ExportsFolder = null or Text.Trim(ExportsFolder) = "" then Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip) else File.Contents(ExportsFolder & "/activity.csv"),
				    Headers = Table.PromoteHeaders(Csv.Document(Source, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Headers, {"simulation_day", "type", "transactions", "fraud_cases", "fraud_amount"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"simulation_day", Int64.Type}, {"type", type text}, {"transactions", Int64.Type}, {"fraud_cases", Int64.Type}, {"fraud_amount", Currency.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
